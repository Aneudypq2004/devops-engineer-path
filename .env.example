# .env.example
# Copy to .env and fill in real values:  cp .env.example .env
# .env is ignored by git. Never commit real credentials.

# Image registry and tag used by compose.yaml (image: ${REGISTRY}/devops-api:${APP_VERSION})
REGISTRY=registry.example.com/your-namespace
APP_VERSION=0.1.0

# PostgreSQL (also used to build the API connection string)
POSTGRES_DB=devops_tasks
POSTGRES_USER=devops_app
POSTGRES_PASSWORD=change-me
